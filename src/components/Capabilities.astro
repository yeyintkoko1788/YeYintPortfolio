---
import { capabilities } from "../data/content";
---
<section class="wrap sec" id="skills" aria-labelledby="skills-h">
  <div data-reveal>
    <p class="mono">Capabilities</p>
    <h2 id="skills-h" class="disp" style="max-width:900px">Build it, structure it, connect it.</h2>
  </div>
  <div class="cols">
    {capabilities.map((g, i) => (
      <div class="card" data-reveal style={`--d:${i * 90}ms`}>
        <p class="mono">0{i + 1} · {g.name}</p>
        <p class="lead">{g.summary}</p>
        <ul class="chips">
          {g.items.map((it) => <li class="chip" title={it.note}>{it.name}</li>)}
        </ul>
      </div>
    ))}
  </div>
</section>
