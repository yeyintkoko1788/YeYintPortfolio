---
import { capabilities } from "../data/content";
const key: Record<string, string> = { Build: "implementation", Structure: "pattern", Connect: "connect" };
---
<section class="wrap sec" id="skills" aria-labelledby="skills-h">
  <div data-reveal>
    <p class="prompt" aria-hidden="true">&gt; cat build.gradle.kts</p>
    <h2 id="skills-h">What I <span>work with</span></h2>
  </div>
  <div class="cols">
    {capabilities.map((g, i) => (
      <div class="win" data-reveal style={`--d:${i * 80}ms`}>
        <div class="win-h">{g.name.toLowerCase()}</div>
        <div class="body">
          <p>{g.summary}</p>
          <ul>
            {g.items.map((it) => <li title={it.note}><span class="s">{key[g.name]}</span> {it.name}</li>)}
          </ul>
        </div>
      </div>
    ))}
  </div>
</section>
