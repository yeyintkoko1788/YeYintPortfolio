---
import { mailto } from "../data/site";
const links = [
  ["Work", "#work"],
  ["Capabilities", "#skills"],
  ["Experience", "#experience"],
];
---
<div class="wrap">
  <header class="nav">
    <a class="brand" href="#top" aria-label="Ye Yint Ko Ko, back to top">
      <span class="brand-mark" aria-hidden="true">YK</span>Ye Yint Ko Ko
    </a>
    <nav class="nav-links" aria-label="Primary">
      {links.map(([label, href]) => <a href={href}>{label}</a>)}
      <a class="btn" href={mailto}>Email me</a>
    </nav>
  </header>
</div>
