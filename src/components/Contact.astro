---
import { site, mailto } from "../data/site";
---
<section class="wrap" aria-labelledby="contact-h">
  <div class="contact" id="contact" data-reveal>
    <p class="mono">Available for remote roles</p>
    <h2 id="contact-h" class="disp">Let's build<br />something.</h2>
    <div class="contact-links">
      <a href={mailto}>{site.email}</a>
      <a href={site.linkedin} rel="noopener">LinkedIn</a>
      <a href={site.github} rel="noopener">GitHub</a>
    </div>
  </div>
</section>
