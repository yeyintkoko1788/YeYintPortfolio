---
import { roles, education } from "../data/content";
---
<section class="exp" id="experience" aria-labelledby="exp-h">
  <h2 id="exp-h" data-reveal>Experience</h2>
  <ol class="exp-list">
    {roles.map((r, i) => (
      <li class="exp-row" data-reveal style={`--d:${(i % 3) * 70}ms`}>
        <p class="exp-dates">{r.dates}<span>{r.place}</span></p>
        <div class="exp-who">
          <h3>{r.company}</h3>
          <p>{r.title}</p>
        </div>
        <p class="exp-line">{r.line}</p>
      </li>
    ))}
  </ol>
  <p class="exp-edu" data-reveal>{education.school}. {education.degree}.</p>
</section>
