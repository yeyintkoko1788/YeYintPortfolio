---
import { site } from "../data/site";
import { roles, education } from "../data/content";
---
<section class="wrap sec" id="experience" aria-labelledby="exp-h">
  <div data-reveal>
    <p class="mono">Experience</p>
    <h2 id="exp-h" class="disp">Building Android<br />since {site.since}.</h2>
  </div>
  <ol class="exp-list">
    {roles.map((r, i) => (
      <li class="exp-row" data-reveal style={`--d:${(i % 3) * 70}ms`}>
        <p class="mono">{r.dates}<span>{r.place}</span></p>
        <div><h3>{r.company}</h3><p>{r.title}</p></div>
        <p>{r.line}</p>
      </li>
    ))}
  </ol>
  <p class="exp-edu" data-reveal>{education.school}. {education.degree}.</p>
</section>
