---
import { roles, education } from "../data/content";
const years = new Date().getFullYear() - 2018;
---
<section class="wrap sec" id="experience" aria-labelledby="exp-h">
  <div data-reveal>
    <p class="prompt" aria-hidden="true">&gt; git log --oneline</p>
    <h2 id="exp-h">{years} years <span>of commits</span></h2>
  </div>
  <ol class="list">
    {roles.map((r, i) => (
      <li class="log sm" data-reveal style={`--d:${(i % 3) * 60}ms`}>
        <span class="when">{r.dates}</span>
        <div><h3>{r.company}</h3><p>{r.title} · {r.place}. {r.line}</p></div>
        <span></span>
      </li>
    ))}
  </ol>
  <p class="prompt" style="margin-top:24px" data-reveal># {education.school}. {education.degree}.</p>
</section>
