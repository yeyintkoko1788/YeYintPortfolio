---
const tech = ["Kotlin", "Jetpack Compose", "Clean Architecture", "Coroutines + Flow", "Socket.IO", "Hilt", "GraphQL"];
---
<div class="marquee" aria-label="Technologies I use">
  {[0, 1].map((n) => (
    <div class="marquee-track" aria-hidden={n === 1 ? "true" : undefined}>
      {tech.map((t) => (<><span>{t}</span><span class="dot" aria-hidden="true">✦</span></>))}
    </div>
  ))}
</div>
