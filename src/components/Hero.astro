---
import { site, mailto } from "../data/site";
---
<section class="wrap hero" id="top" aria-label="Introduction">
  <div>
    <p class="prompt g" aria-hidden="true">&gt; whoami</p>
    <h1>Ye Yint<br />Ko Ko<span class="cur" aria-hidden="true"></span></h1>
    <p class="hero-lead">{site.role}. Kotlin and Compose since {site.since}, one app past 1M Play downloads. Open to remote roles with international teams.</p>
    <div class="hero-cta">
      <a class="btn" href={mailto}>$ send --email</a>
      <a class="btn o" href="#work">$ ls work/</a>
    </div>
  </div>
  <div class="win" aria-hidden="true">
    <div class="win-h"><i></i><i></i><i></i><span>ChatScreen.kt</span></div>
    <pre class="code"><span class="c">// one core, three apps</span>
<span class="k">@Composable</span>
<span class="k">fun</span> <span class="f">Channel</span>(vm: <span class="f">ChatViewModel</span>) {'{'}
  <span class="k">val</span> msgs <span class="k">by</span> vm.messages.<span class="f">collectAsState</span>()

  <span class="f">LazyColumn</span> {'{'}
    <span class="f">items</span>(msgs) {'{'} m <span class="k">-&gt;</span>
      <span class="f">Bubble</span>(
        text = m.text,
        status = m.<span class="s">receipt</span>, <span class="c">// delivered, read</span>
      )
    {'}'}
  {'}'}
{'}'}</pre>
    <div class="statusbar"><span><i>●</i> build passing</span><span>1M+ downloads</span><span>{site.location.split(",")[0]} · {site.utcLabel}</span></div>
  </div>
</section>
