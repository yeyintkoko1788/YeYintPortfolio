---
import { projects } from "../data/content";
const badge: Record<string, string> = { saya: "1M+ downloads", messaging: "3 apps, 1 core" };
---
<section class="wrap sec" id="work" aria-labelledby="work-h">
  <div data-reveal>
    <p class="prompt" aria-hidden="true">&gt; ls -la work/</p>
    <h2 id="work-h">Selected <span>work</span></h2>
  </div>
  <ol class="list">
    {projects.map((p, i) => (
      <li class="log" data-reveal style={`--d:${(i % 3) * 60}ms`}>
        <span class="when">{p.year}</span>
        <div>
          <h3>{p.name.toLowerCase().replace(/\s+/g, "-")}{badge[p.id] && <span class="pill">{badge[p.id]}</span>}</h3>
          <p>{p.role}. {p.decision}</p>
          <p style="font-size:15px">{p.meta}</p>
        </div>
        <span class="side">{p.stack.split(", ")[0]}</span>
      </li>
    ))}
  </ol>
</section>
